package setting

import (
	"context"
	"errors"

	configuration "github.com/frost-leo/fathomry/framework/configuration/v1"
	"github.com/frost-leo/fathomry/i18n/v1"
)

// Config is the project's complete configuration; add only capabilities it uses.
type Config struct {
	Application Application `json:"application"`
}

// Schema supplies typed defaults and pure validation, never source acquisition.
// Bootstrap supplies immutable startup facts; configuration cannot replace them.
func Schema(build Build, environment string, instance Instance) configuration.Schema[Config] {
	return configuration.Schema[Config]{
		Version: 1,
		Defaults: Config{Application: Application{
			Name: ApplicationName, DisplayName: ApplicationName, Build: build,
			Deployment: Deployment{Environment: environment}, Instance: instance,
			Timezone: "UTC", I18n: i18n.Preferences{Locale: "en"},
		}},
		Validate: func(ctx context.Context, value Config) error {
			if value.Application.Build != build || value.Application.Deployment.Environment != environment || value.Application.Instance != instance {
				return errors.New("configuration cannot replace startup-owned application facts")
			}
			return errors.Join(value.Application.Validate(), ctx.Err())
		},
	}
}
