package main

import (
	"bytes"
	"context"
	"encoding/json"
	"strings"
	"testing"

	cli "github.com/frost-leo/fathomry/cmd/fathomry/v1"
)

func TestCLIEntry(t *testing.T) {
	for _, sample := range []struct {
		name     string
		args     []string
		canceled bool
		code     int
	}{
		{"help", []string{"--lang", "zh-CN", "--output", "json", "help"}, false, 0},
		{"unknown", []string{"not-a-supported-project-command"}, false, 2},
		{"canceled", []string{"help"}, true, 130},
	} {
		t.Run(sample.name, func(t *testing.T) {
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			if sample.canceled {
				cancel()
			}
			var output, diagnostic bytes.Buffer
			code := execute(ctx, sample.args, cli.Options{
				Input: strings.NewReader(""), Output: &output, ErrorOutput: &diagnostic,
			})
			if code != sample.code {
				t.Fatalf("exit=%d want=%d", code, sample.code)
			}
			if code == 0 && (!json.Valid(output.Bytes()) || diagnostic.Len() != 0) {
				t.Fatal("help lost valid machine output or mixed diagnostic streams")
			}
			if code != 0 && (output.Len() != 0 || diagnostic.Len() == 0) {
				t.Fatal("failure mixed output and diagnostics")
			}
		})
	}
}
