[[.GoNotice]]// Package localization owns project messages, not configuration acquisition.
package localization

import (
 "embed"

 "[[.Module]]/internal/resource"
 "github.com/frost-leo/fathomry/i18n"
)

//go:embed locales/*.json
var resources embed.FS

// DefaultLocale is available before configuration loading for help and failures.
// Successfully loaded project settings may select a different default.
const DefaultLocale=resource.DefaultLocale

// Catalog prepares the explicitly selected project resources without globals.
func Catalog()(*i18n.Catalog,error){
 var inputs []i18n.Resource
 for _,name:=range []string{"en","zh-Hans"}{
  data,err:=resources.ReadFile("locales/"+name+".json")
  if err!=nil{return nil,i18n.InvalidResource}
  inputs=append(inputs,i18n.Resource{Name:name+".json",Data:data})
 }
 return i18n.Prepare(inputs)
}
