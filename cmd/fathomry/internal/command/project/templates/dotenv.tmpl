[[.YAMLNotice]]# Explicit input only: copy this example, restrict permissions and use --env-file.
# Only declared [[.Environment]] bindings are consumed. Process variables win,
# including empty values. No interpolation or shell commands are evaluated.
[[.Prefix]]_[[upper .Environment]]_I18N_DEFAULT_LOCALE=[[.DefaultLocale]]
[[if .RemoteEnvironment]]
# Required Nacos bootstrap. Set actual private values outside version control.
[[.Prefix]]_[[upper .Environment]]_NACOS_HTTP_URL=
[[.Prefix]]_[[upper .Environment]]_NACOS_GRPC_ADDRESS=
[[.Prefix]]_[[upper .Environment]]_NACOS_NAMESPACE=
[[.Prefix]]_[[upper .Environment]]_NACOS_GROUP=DEFAULT_GROUP
[[.Prefix]]_[[upper .Environment]]_NACOS_BASE_ID=[[.Name]].base.yaml
[[.Prefix]]_[[upper .Environment]]_NACOS_ENVIRONMENT_ID=[[.Name]].[[.Environment]].yaml
[[.Prefix]]_[[upper .Environment]]_NACOS_LOCAL_ID=[[.Name]].[[.Environment]].local.yaml
[[.Prefix]]_[[upper .Environment]]_NACOS_USERNAME=
[[.Prefix]]_[[upper .Environment]]_NACOS_PASSWORD=
# Double quotes allow escaped newlines for an explicit trust bundle.
[[.Prefix]]_[[upper .Environment]]_NACOS_ROOT_CA_PEM=""
[[.Prefix]]_[[upper .Environment]]_NACOS_ALLOW_INSECURE=false
[[end]]
