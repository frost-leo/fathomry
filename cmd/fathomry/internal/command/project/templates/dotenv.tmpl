# This example is inert. Copy deliberately and select with --dotenv .env.
# Provider {{.Provider}} and format {{.Encoding}} are explicit in generated Go code.
FATHOMRY_ENV=development
{{if eq .Mode "local"}}FATHOMRY_CONFIG_DIR=configs
# FATHOMRY_LOCAL_CONFIG=configs/local/development.{{.Encoding}}
{{else}}FATHOMRY_BOOTSTRAP=bootstrap.{{.Encoding}}
# Supply secrets from the deployment environment or a protected dotenv file:
# FATHOMRY_NACOS_USERNAME=
# FATHOMRY_NACOS_PASSWORD=
# FATHOMRY_NACOS_ROOT_CA_PEM=
{{end}}
# Application overrides are explicitly bound separately, not read from dotenv.
# Process-only example: FATHOMRY_APP_LOCALE=zh-CN
