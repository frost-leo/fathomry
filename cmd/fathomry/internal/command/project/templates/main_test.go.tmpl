func TestEntryFailure(t *testing.T) {
	var output bytes.Buffer
	if run(context.Background(), []string{"--unknown=private-canary"}, &output) == nil {
		t.Fatal("unsupported option")
	}
	var report struct {
		Accepted bool `json:"configuration_accepted"`
		Worker   bool `json:"worker_started"`
	}
	if json.Unmarshal(output.Bytes(), &report) != nil || report.Accepted || report.Worker || bytes.Contains(output.Bytes(), []byte("private-canary")) {
		t.Fatal("unsafe failure report")
	}
}
func TestProcessContext(t *testing.T) {
	ctx, stop := processContext()
	stop()
	stop()
	if ctx.Err() == nil {
		t.Fatal("signal owner not released")
	}
}

{{if eq .Mode "local"}}
func TestEntryLocal(t *testing.T) {
	for _, entry := range os.Environ() {
		name, value, present := strings.Cut(entry, "=")
		if present && strings.HasPrefix(name, "FATHOMRY_") {
			t.Setenv(name, value)
			if os.Unsetenv(name) != nil {
				t.Fatal("environment isolation failed")
			}
		}
	}
	root, err := filepath.Abs("../..")
	if err != nil {
		t.Fatal(err)
	}
	t.Chdir(root)
	var output bytes.Buffer
	if err := run(context.Background(), nil, &output); err != nil {
		t.Fatal("relative startup failed", err)
	}
	var report struct {
		Code     string `json:"code"`
		Accepted bool   `json:"configuration_accepted"`
	}
	if json.Unmarshal(output.Bytes(), &report) != nil || !report.Accepted {
		t.Fatal("startup not accepted")
	}
	output.Reset()
	err = run(context.Background(), []string{"--config-dir", t.TempDir()}, &output)
	if !errors.Is(err, configuration.ErrMissing) {
		t.Fatal("missing cause lost", err)
	}
	var occurrence failure.Occurrence
	if !errors.As(err, &occurrence) {
		t.Fatal("public identity lost")
	}
	info, _ := failure.Inspect(occurrence)
	if json.Unmarshal(output.Bytes(), &report) != nil || report.Accepted || report.Code != info.Diagnostic().Definition.Code.String() {
		t.Fatal("public error projection changed")
	}
}

