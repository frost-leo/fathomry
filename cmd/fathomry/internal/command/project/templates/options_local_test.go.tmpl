package bootstrap

import (
	"context"
	"testing"

	configuration "github.com/frost-leo/fathomry/framework/configuration/v1"
)

func TestOptions(t *testing.T) {
	seen := map[string]bool{}
	lookup := func(name string) (string, bool) { seen[name] = true; return "", false }
	value, err := ParseOptions(context.Background(), nil, lookup)
	if err != nil || value.Environment != "development" || value.Directory != "configs" || value.Encoding != DocumentEncoding {
		t.Fatal(err)
	}
	for name := range seen {
		if name == "FATHOMRY_NACOS_PASSWORD" || name == "FATHOMRY_CONFIG_PROVIDER" {
			t.Fatal("unselected provider inspected")
		}
	}
	for _, args := range [][]string{
{"--env="}, {"--env=../production"}, {"--bootstrap=ignored"}, {"--config-dir="}, {"--config-source=local"}} {
		if _, err := ParseOptions(context.Background(), args, lookup); err == nil {
			t.Fatal("invalid project choice accepted")
		}
	}
	value.Encoding = configuration.TOML
	if err := value.validate(); err != nil {
		t.Fatal(err)
	}
	value.Encoding = "xml"
	if err := value.validate(); err == nil {
		t.Fatal("unsupported format admitted")
	}
}
