[[.GoNotice]]package main

import (
 "context"
 "encoding/json"
 "errors"
 "flag"
 "io"
 "os"
 "os/signal"

 "[[.Module]]/internal/configuration"
 "[[.Module]]/internal/localization"
 "github.com/frost-leo/fathomry/failure"
 framework "github.com/frost-leo/fathomry/framework/configuration"
 "github.com/frost-leo/fathomry/i18n"
)

func main() {
 ctx,stop:=signal.NotifyContext(context.Background(),os.Interrupt)
 stopped:=make(chan struct{})
 go func(){<-ctx.Done();stop();close(stopped)}()
 status:=run(ctx,os.Args[1:],os.Stdout,os.Stderr)
 stop()
 <-stopped
 os.Exit(status)
}

func run(ctx context.Context,args []string,out,diagnostics io.Writer)int{
 catalog,err:=localization.Catalog()
 if err!=nil{return 1}
 locale:=localization.DefaultLocale
 report:=func(err error,status int)int{
  code:=framework.Unavailable
  if occurrence,ok:=failure.Inspect(err);ok{code=occurrence.Code()}else{
   var identity failure.Code
   if errors.As(err,&identity){code=identity}
  }
  if errors.Is(err,context.Canceled){status=130}
  messageID:="fathomry.generated.error"
  switch {
  case errors.Is(err,i18n.InvalidLocale):messageID="fathomry.generated.invalid_locale"
  case code==framework.InvalidInput:messageID="fathomry.generated.invalid_input"
  case code==framework.Invalid:messageID="fathomry.generated.invalid_data"
  case code==framework.Unavailable:messageID="fathomry.generated.unavailable"
  }
  message,renderErr:=catalog.Render(locale,messageID,i18n.Arguments{"Code":string(code)})
  text:=string(code)
  if renderErr==nil{text=message.Text}
  _,_=io.WriteString(diagnostics,text+"\n")
  return status
 }
 if len(args)>128{return report(framework.InvalidInput,2)}
 bytes:=0
 for _,arg:=range args{
  bytes+=len(arg)
  if bytes>64<<10{return report(framework.InvalidInput,2)}
 }
 flags:=flag.NewFlagSet("[[.Name]]",flag.ContinueOnError)
 flags.SetOutput(io.Discard)
 options:=configuration.Options{}
 flags.StringVar(&options.Root,"root",".","")
 flags.StringVar(&options.Environment,"environment","","")
 flags.StringVar(&options.EnvFile,"env-file","","")
 flags.BoolVar(&options.Local,"local",false,"")
 override:=flags.String("lang","","")
 help:=flags.Bool("help",false,"")
 flags.BoolVar(help,"h",false,"")
 if flags.Parse(args)!=nil || flags.NArg()!=0{return report(framework.InvalidInput,2)}
 selected,err:=(i18n.Settings{DefaultLocale:localization.DefaultLocale}).Locale(*override)
 if err!=nil{return report(framework.InvalidInput,2)}
 locale=selected
 if *help{
  message,err:=catalog.Render(locale,"fathomry.generated.help",i18n.Arguments{"Project":"[[.Name]]"})
  if err!=nil{return report(err,1)}
  text:=message.Text+"\n"
  count,err:=io.WriteString(out,text)
  if err!=nil || count!=len(text){return 1}
  return 0
 }
 loaded,err:=configuration.Load(ctx,options)
 if err!=nil{
  status:=1
  if errors.Is(err,framework.InvalidInput){status=2}
  return report(err,status)
 }
 value,err:=loaded.Value()
 if err!=nil{return report(err,1)}
 selected,err=value.I18n.Locale(*override)
 if err!=nil{return report(err,1)}
 locale=selected
 if err:=ctx.Err();err!=nil{return report(err,1)}
 message,err:=catalog.Render(locale,"fathomry.generated.valid",nil)
 if err!=nil{return report(err,1)}
 data,err:=json.Marshal(struct{
  Environment string `json:"environment"`
  Message string `json:"message"`
  Locale string `json:"locale"`
  Configuration framework.Description `json:"configuration"`
 }{options.Environment,message.Text,message.ResourceLocale,loaded.Description()})
 if err!=nil{return 1}
 data=append(data,'\n')
 count,err:=out.Write(data)
 if err!=nil || count!=len(data){return 1}
 return 0
}
