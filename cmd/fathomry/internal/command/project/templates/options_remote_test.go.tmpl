package bootstrap

import (
	"context"
	"testing"
)

func TestOptions(t *testing.T) {
	values := map[string]string{"FATHOMRY_NACOS_USERNAME": "explicit", "FATHOMRY_NACOS_PASSWORD": ""}
	lookup := func(name string) (string, bool) { value, present := values[name]; return value, present }
	if _, err := ParseOptions(context.Background(), nil, lookup); err == nil {
		t.Fatal("connection path inferred")
	}
	options, err := ParseOptions(context.Background(), []string{"--bootstrap=explicit.yaml"}, lookup)
	if err != nil || options.Environment != "development" || options.Bootstrap != "explicit.yaml" || len(options.Credentials) != 2 || !options.Credentials[1].Present || options.Credentials[1].Value != "" {
		t.Fatal("explicit credential presence lost", err)
	}
	for _, args := range [][]string{
{"--env="}, {"--env=../production"}, {"--config-dir=ignored"}, {"--config-provider=nacos"}} {
		if _, err := ParseOptions(context.Background(), args, lookup); err == nil {
			t.Fatal("invalid options accepted")
		}
	}
}
