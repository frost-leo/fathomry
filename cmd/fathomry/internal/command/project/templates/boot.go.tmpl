package bootstrap

import (
	"context"
	"{{.Module}}/internal/setting"
	configuration "github.com/frost-leo/fathomry/framework/configuration/v1"
)

func declaration(options Options) configuration.Declaration[setting.Settings] {
	return configuration.Declaration[setting.Settings]{
		Schema:    configuration.Schema[setting.Settings]{Version: 1, Defaults: setting.Defaults(), Validate: setting.Validate},
		Variables: options.Variables,
	}
}

// Boot loads accepted project settings and joins finite source cleanup.
// Records remain available on failure; a cleanup failure does not erase State.
func Boot(ctx context.Context, options Options) (configuration.Result[setting.Settings], error) {
	dependencies, records, err := dependencies(ctx, options)
	if err != nil {
		return configuration.Result[setting.Settings]{Records: records}, err
	}
	result, err := configuration.Load(ctx, declaration(options), dependencies)
	result.Records = append(records, result.Records...)
	return result, err
}

// Watch starts the same declared project as a live configuration domain.
// The second result contains released startup records, including on failure.
// The caller closes the watcher; its own final records are available after release.
func Watch(ctx context.Context, options Options) (*configuration.Watcher[setting.Settings], []configuration.Record, error) {
	dependencies, records, err := dependencies(ctx, options)
	if err != nil {
		return nil, records, err
	}
	watch, err := configuration.Watch(ctx, declaration(options), dependencies, configuration.WatchOptions{})
	return watch, records, err
}
