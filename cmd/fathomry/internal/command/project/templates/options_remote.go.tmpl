package bootstrap

import (
	"context"
	"errors"
	configuration "github.com/frost-leo/fathomry/framework/configuration/v1"
)

type Options struct {
	Bootstrap   string
	Environment string
	Encoding    configuration.Encoding
	Credentials []configuration.Variable
	Variables   []configuration.Variable
	Records     []configuration.Record
}

func ParseOptions(ctx context.Context, args []string, lookup func(string) (string, bool)) (Options, error) {
	inputs, err := configuration.ReadInputs(ctx, configuration.InputOptions{
		Arguments: args, Lookup: lookup, DotenvFlag: "dotenv", DotenvEnvironment: "FATHOMRY_DOTENV",
		Bindings: []configuration.InputBinding{
			{Name: "environment", Flag: "env", Environment: "FATHOMRY_ENV", Default: "development", HasDefault: true, Dotenv: true},
			{Name: "bootstrap", Flag: "bootstrap", Environment: "FATHOMRY_BOOTSTRAP", Dotenv: true},
			{Name: "locale", Environment: "FATHOMRY_APP_LOCALE"},
			{Name: "username", Environment: "FATHOMRY_NACOS_USERNAME", Dotenv: true},
			{Name: "password", Environment: "FATHOMRY_NACOS_PASSWORD", Dotenv: true},
			{Name: "root_ca_pem", Environment: "FATHOMRY_NACOS_ROOT_CA_PEM", Dotenv: true},
		},
	})
	options := Options{Encoding: DocumentEncoding, Records: inputs.Records()}
	if err != nil {
		return options, err
	}
	options.Bootstrap, _ = inputs.Lookup("bootstrap")
	options.Environment, _ = inputs.Lookup("environment")
	options.Variables = applicationVariables(inputs)
	for _, name := range []string{"username", "password", "root_ca_pem"} {
		if value, present := inputs.Lookup(name); present {
			options.Credentials = append(options.Credentials, configuration.Variable{Path: "/connection/" + name, Value: value, Present: true})
		}
	}
	return options, options.validate()
}
func (options Options) validate() error {
	if !environmentName(options.Environment) || options.Bootstrap == "" ||
		options.Encoding != configuration.YAML && options.Encoding != configuration.TOML {
		return errors.New("invalid remote project inputs")
	}
	return nil
}

func dependencies(ctx context.Context, options Options) (configuration.Dependencies, []configuration.Record, error) {
	records := append([]configuration.Record(nil), options.Records...)
	if ctx == nil {
		return configuration.Dependencies{}, records, errors.New("missing startup context")
	}
	if err := options.validate(); err != nil {
		return configuration.Dependencies{}, records, err
	}
	provider, startup, err := configuration.PrepareNacos(ctx, configuration.NacosBootstrapOptions{
		File: options.Bootstrap, Environment: options.Environment, Encoding: options.Encoding, Variables: options.Credentials,
	})
	return configuration.Dependencies{Provider: provider}, append(records, startup...), err
}
