package bootstrap

import (
	configuration "github.com/frost-leo/fathomry/framework/configuration/v1"
	"strings"
)

func applicationVariables(values configuration.Inputs) []configuration.Variable {
	value, present := values.Lookup("locale")
	if !present {
		return nil
	}
	return []configuration.Variable{ {Path: "/application/i18n/locale", Value: value, Present: true}}
}
func environmentName(value string) bool {
	if len(value) == 0 || len(value) > 64 || value[0] < 'a' || value[0] > 'z' {
		return false
	}
	return !strings.ContainsFunc(value, func(char rune) bool {
		return !(char >= 'a' && char <= 'z' || char >= '0' && char <= '9' || char == '_' || char == '-')
	})
}

// DocumentEncoding is selected at creation, never inferred from a source.
const DocumentEncoding = configuration.{{if eq .Encoding "yaml"}}YAML{{else}}TOML{{end}}
