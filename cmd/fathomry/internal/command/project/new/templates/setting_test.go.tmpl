package setting

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"log/slog"
	"strings"
	"testing"
)

func TestSettings(t *testing.T) {
	value := Defaults()
	if err := Validate(context.Background(), value); err != nil {
		t.Fatal(err)
	}
	if value.Database.Fathomry != nil { t.Fatal("control target must be opt-in") }
	value.Database.Fathomry = &FathomryDatabase{}
	if Validate(context.Background(), value) == nil { t.Fatal("invalid control target accepted") }
	value = Defaults()
	value.Application.Name = "other"
	if Validate(context.Background(), value) == nil {
		t.Fatal("identity validation missing")
	}
	value = Defaults()
	value.Application.I18n.Locale = "not a locale"
	if Validate(context.Background(), value) == nil {
		t.Fatal("component validation missing")
	}
	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	if Validate(ctx, Defaults()) == nil {
		t.Fatal("cancellation ignored")
	}
}

func TestSettingsDiagnostics(t *testing.T) {
	value := Defaults()
	value.Database.Fathomry = &FathomryDatabase{Dialect: "private-database-canary"}
	for _, input := range []any{value, &value, value.Database, &value.Database, *value.Database.Fathomry, value.Database.Fathomry} {
		if strings.Contains(fmt.Sprintf("%+v %#v", input, input), "private-database-canary") { t.Fatal("formatted deployment data exposed") }
		var output bytes.Buffer
		slog.New(slog.NewJSONHandler(&output, nil)).Info("configuration", "value", input)
		if strings.Contains(output.String(), "private-database-canary") { t.Fatal("logged deployment data exposed") }
	}
	raw, err := json.Marshal(value)
	if err != nil || !bytes.Contains(raw, []byte("private-database-canary")) { t.Fatal("explicit configuration encoding changed", err) }
}

func TestProjectOwnsDatabaseSettings(t *testing.T) {
	var value Database
	if err := json.Unmarshal([]byte(`{"fathomry":{"dialect":"mysql","mysql":{"name":"project-control","address":"127.0.0.1","port":1,"database":"project_control","user":"test","password":"private-canary","plaintext":true}}}`), &value); err != nil { t.Fatal(err) }
	if err := value.Validate(); err != nil { t.Fatal(err) }
	copy := value.Fathomry.Copy()
	copy.MySQL.Password = "changed"
	if value.Fathomry.MySQL.Password != "private-canary" { t.Fatal("project database settings alias a handoff copy") }
}
