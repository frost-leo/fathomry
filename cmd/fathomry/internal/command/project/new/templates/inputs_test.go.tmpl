package bootstrap

import (
	"context"
	configuration "github.com/frost-leo/fathomry/framework/configuration/v1"
	"testing"
)

func TestProjectInputRules(t *testing.T) {
	for _, name := range []string{"", "../production", "development/file", "Production"} {
		if environmentName(name) {
			t.Fatal("invalid environment selector")
		}
	}
	values, err := configuration.ReadInputs(context.Background(), configuration.InputOptions{
		Lookup:   func(string) (string, bool) { return "", true },
		Bindings: []configuration.InputBinding{ {Name: "locale", Environment: "EXPLICIT_LOCALE"}},
	})
	if err != nil {
		t.Fatal(err)
	}
	variables := applicationVariables(values)
	if len(variables) != 1 || !variables[0].Present || variables[0].Value != "" {
		t.Fatal("explicit empty override lost")
	}
}
