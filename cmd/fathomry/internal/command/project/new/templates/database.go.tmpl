package setting

import (
 "errors"
 "fmt"
 "log/slog"
 "time"
 mysql "github.com/frost-leo/fathomry/adapters/database/mysql/v1"
 postgres "github.com/frost-leo/fathomry/adapters/database/postgres/v1"
)

// Database declares this application's named database roles. It contains no
// runtime handles or build-machine values; offline commands need no binding.
type Database struct {
 Fathomry *FathomryDatabase `json:"fathomry"`
}

// FathomryDatabase is project-owned deployment data. Exactly one provider matches
// Dialect; PostgreSQL additionally requires an explicit physical Schema.
type FathomryDatabase struct {
 Dialect string `json:"dialect"`
 Schema string `json:"schema"`
 PostgreSQL *postgres.Settings `json:"postgresql"`
 MySQL *mysql.Settings `json:"mysql"`
 Timeout time.Duration `json:"timeout_ns"`
 CleanupTimeout time.Duration `json:"cleanup_timeout_ns"`
}

func (value FathomryDatabase) Copy() FathomryDatabase {
 if value.PostgreSQL != nil { selected := *value.PostgreSQL; value.PostgreSQL = &selected }
 if value.MySQL != nil { selected := *value.MySQL; value.MySQL = &selected }
 return value
}

// Validate performs offline admission only; it never constructs resources or SQL.
func (value Database) Validate() error {
 if value.Fathomry == nil { return nil }
 selected := value.Fathomry
 invalid := errors.New("invalid control database binding")
 for _, timeout := range []time.Duration{selected.Timeout, selected.CleanupTimeout} {
  if timeout != 0 && (timeout < time.Millisecond || timeout > time.Minute) { return invalid }
 }
 switch selected.Dialect {
 case "postgresql":
  if selected.PostgreSQL == nil || selected.MySQL != nil || selected.Schema == "" { return invalid }
  return postgres.Validate(*selected.PostgreSQL)
 case "mysql":
  if selected.MySQL == nil || selected.PostgreSQL != nil || selected.Schema != "" || selected.MySQL.Database == "" { return invalid }
  return mysql.Validate(*selected.MySQL)
 default:
  return invalid
 }
}

// Explicit JSON can contain credentials; ordinary diagnostics cannot.
func (Database) Format(state fmt.State, _ rune) { _, _ = state.Write([]byte("setting.Database")) }
func (Database) LogValue() slog.Value { return slog.StringValue("setting.Database") }
func (FathomryDatabase) Format(state fmt.State, _ rune) { _, _ = state.Write([]byte("setting.FathomryDatabase")) }
func (FathomryDatabase) LogValue() slog.Value { return slog.StringValue("setting.FathomryDatabase") }
