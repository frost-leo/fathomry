      "forms": {
        "other": "操作运行时选项或声明无效。"
      }
    },
    {
      "id": "fathomry.operation.invalid_handle",
      "source": "00323e95bcd046944ea0a124678b0ff06c2ea9fdb5e6d37aba37628e98698771",
      "forms": {
        "other": "操作运行时或句柄未初始化。"
      }
    },
    {
      "id": "fathomry.operation.closed",
      "source": "46be6b20f5e7a68473bdabfaccd2ac2c5e150d84f265f851429d69fcbe2868f5",
      "forms": {
        "other": "操作运行时或接收器正在关闭或已关闭。"
      }
    },
    {
      "id": "fathomry.operation.limit_exceeded",
