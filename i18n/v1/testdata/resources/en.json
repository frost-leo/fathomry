  "schema": "fathomry.i18n-resource/v1",
  "profile": "scalar-cardinal/v1",
  "owner": "example.inventory",
  "locale": "en",
  "messages": [
    {
      "id": "example.inventory:items",
      "contract": "v1",
      "context": "Available items at an approved public location.",
      "args": {
        "place": {
          "kind": "string",
          "meaning": "Public display label, never credentials."
        }
      },
      "cardinal": true,
      "forms": {
        "one": "{count} item at {place}",
        "other": "{count} items at {place}"
      }
    },
    {
      "id": "example.inventory:english",
      "contract": "v1",
      "context": "Deliberately untranslated integer message.",
      "args": {},
      "cardinal": true,
      "forms": {
        "one": "{count} source item",
        "other": "{count} source items"
      }
    },
    {
      "id": "example.inventory:identity",
      "contract": "v1",
      "context": "Real text equal to its exact message identity.",
      "args": {},
      "cardinal": false,
      "forms": {
        "other": "example.inventory:identity"
      }
    },
    {
      "id": "example.inventory:field",
      "contract": "v1",
      "context": "An approved field name from one selected failure occurrence.",
      "args": {
        "field": {
          "kind": "string",
          "meaning": "Public field identifier."
        }
      },
      "cardinal": false,
      "forms": {
        "other": "Invalid field: {field}."
      }
    },
    {
      "id": "example.inventory:scalars",
      "contract": "v1",
      "context": "Exact scalar formatting without locale conversion.",
      "args": {
        "s": {
          "kind": "string",
          "meaning": "Literal data."
        },
        "i": {
          "kind": "int64",
          "meaning": "Signed integer."
        },
        "u": {
          "kind": "uint64",
          "meaning": "Unsigned integer."
        },
        "b": {
          "kind": "bool",
          "meaning": "Boolean."
        }
      },
      "cardinal": false,
      "forms": {
        "other": "{{{s}}} {i} {u} {b} 100%"
      }
    }
  ]
}
