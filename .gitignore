# Go build and test artifacts, based on github/gitignore/Go.gitignore
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov
go.work
go.work.sum

# Local configuration and credentials; public test fixtures remain trackable
.env
.env.*
!.env.example
configs/local.*
*.local.yaml
*.local.yml
/secrets/
/credentials/
/.duckdb-skills/

# Build, test, and runtime output
/bin/
/dist/
/build/
/coverage/
/tmp/
*.prof
*.log

# Editor and local agent state
.DS_Store
.idea/
.vscode/
.codex/
.playwright-cli/
